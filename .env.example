# ============================================================
# WhatIfIBought 本地开发 / 传统 Compose 环境配置模板
#
#   本地开发: cp .env.example .env.local 填值
#             之后 IDEA 直接点 Run，或 ./start-local.ps1 一键起三服务
#   传统部署: 服务器上命名为 .env 放 compose 同目录，容器自动注入
#   Zeabur:   根 Dockerfile 会直接读取同项目 PostgreSQL / Redis 暴露的变量，
#             不需要上传本文件；账号和可选能力在 WTFiB 服务变量中单独设置
#
#   只有 PG_USER / PG_PASSWORD 必填（缺了启动即报 placeholder 错误）
#   其余不填走默认值也能启动，对应功能降级
#   注意: 注释必须独立成行，行内注释会被当成值的一部分
# ============================================================

# ---- PostgreSQL（必填）----
# docker 部署 HOST 填容器名(如 postgres)或宿主机内网 IP，写 localhost 会指向容器自己
PG_HOST=localhost
PG_PORT=5432
PG_DB=wiib
PG_USER=
PG_PASSWORD=

# ---- Redis ----
# HOST 填法同上；无密码留空
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ---- Redis 主从-哨兵（可选，线上高可用，配合 redis-compose.yml 栈）----
# 放开下一行即切哨兵模式（REDIS_HOST/PORT 被忽略，PASSWORD/DB 照常生效）
# 哨兵节点默认 redis-sentinel-1:26379,redis-sentinel-2:26379,redis-sentinel-3:26379，非默认才需填 REDIS_SENTINEL_NODES
# SPRING_PROFILES_ACTIVE=sentinel
# REDIS_SENTINEL_MASTER=mymaster
# REDIS_SENTINEL_NODES=

# ---- LinuxDo OAuth（可选，不配则关闭 LinuxDo 登录）----
LINUXDO_CLIENT_ID=
LINUXDO_CLIENT_SECRET=
LINUXDO_REDIRECT_URI=http://localhost:3000/login

# ---- 账号密码登录 + 邀请码注册（可选，与 LinuxDo 并存）----
# 开启后登录页出现"账号密码 + 邀请码注册"入口，同时管理员直登自动关闭
# ADMIN_PASSWORD = 给管理员账号(id=1)设的登录密码
# 必须配它：邀请码只有管理员能生成，id=1 没密码就没人能进 Admin 页生成码，谁也注册不了
# id=1 是谁：全新库=自动创建的 admin；已有 LinuxDo 的库=首个 OAuth 用户，用其用户名+此密码登录
PASSWORD_LOGIN_ENABLED=false
ADMIN_PASSWORD=

# ---- New API 主站 SSO + 额度桥接（可在 WTFiB Admin 页直接配置）----
# 下列变量都是“部署级覆盖”：一旦取消注释，对应 Admin 字段会只读，并以这里为准。
# 普通部署建议全部保持注释，启动后在 Admin 页配置；紧急停用或平台托管密钥时再使用。
# APP_SECRET 至少 16 字符，必须与 New API 的 EXTERNAL_GAME_APP_SECRET 完全一致。
# NEW_API_ENABLED=false
# NEW_API_BASE_URL=https://youzi.today
# NEW_API_APP_ID=wtfib
# NEW_API_APP_SECRET=
# NEW_API_QUOTA_PER_UNIT=500000
# NEW_API_WITHDRAWAL_ENABLED=false
# NEW_API_WITHDRAWAL_PROFIT_RATE=0.50
# NEW_API_WITHDRAWAL_DAILY_LIMIT=100.00
# NEW_API_WITHDRAWAL_MIN_AMOUNT=1.00
# NEW_API_WITHDRAWAL_ZONE_ID=Asia/Shanghai
# NEW_API_WITHDRAWAL_TAX_BRACKETS=20:0.05,50:0.10,100:0.15,*:0.20
# 以下三项始终是启动级参数，不在管理后台热更新。
# NEW_API_CONNECT_TIMEOUT=3000
# NEW_API_READ_TIMEOUT=8000
# NEW_API_RECONCILE_INTERVAL_MS=30000

# ---- Binance 公共行情端点（可选，默认值已适配美东等主站受限出口）----
# 仅在自建代理或官方端点变更时覆盖；公开现货行情不需要 Binance API Key。
# BINANCE_SPOT_WS_URL=wss://data-stream.binance.vision/ws
# BINANCE_SPOT_REST_URL=https://data-api.binance.vision
# BINANCE_FUTURES_WS_URL=wss://fstream.binance.com/ws
# BINANCE_FUTURES_REST_URL=https://fapi.binance.com

# ---- Binance USDT-M Testnet（可选，策略 testnet 轨下单用；不填仅 sim 模拟盘轨可用）----
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_SECRET_KEY=

# ---- BlockBeats 快讯（可选，不填新闻功能降级）----
BLOCKBEATS_API_KEY=

# ---- 内部服务间鉴权 token（传统三容器部署须同值；单容器部署不填会自动共享内部值）----
INTERNAL_API_TOKEN=

# ---- 时区（可选；Zeabur 单容器默认 Asia/Shanghai，传统 Compose 默认 Asia/Singapore）----
# TZ=Asia/Shanghai
